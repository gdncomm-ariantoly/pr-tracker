{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["lib/**/*.js", "pages/**/*.js", "background.js", "platform.js", "tests/**/*.js", "tools/**/*.mjs", "native/**/*.mjs"]
}
